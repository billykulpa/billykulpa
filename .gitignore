# Real credentials live only on the machines that need them.
app/config.php
app/cache/
# Admin uploads (the About portrait) live only on the server.
public/assets/uploads/
# OS noise
.DS_Store
# Git bundles are transport containers for the push workflow; once pulled
# and pushed they're spent. Never commit them.
*.bundle
# Design source exports live beside the repo, not in it.
figma-exports/
# One-time SQL migrations are delivered and run in phpMyAdmin, not tracked;
# schema.sql remains the canonical schema.
add-*.sql

# Capture masters. The 24-bit WAVs and raw iPhone .MOV files from the Track
# & Field session are 600+ MB and blow past GitHub's 100 MB file limit. Keep
# them on disk, back them up outside git. The WEB-READY derivatives that the
# site actually serves -- tf-*.m4a, tf-*.mp4, tf-*-poster.jpg -- stay tracked.
public/assets/audio/*.wav
public/assets/audio/*.aif
public/assets/audio/*.aiff
public/assets/video/*.MOV
public/assets/video/*.mov
# Raw social downloads arrive with spaces and @handles in the filename.
public/assets/video/@*

# Contact-form mail log. contact.php writes to app/../logs when mail_mode is
# 'log', so a local dev session with a real submission would otherwise commit
# someone's name and email to a public repo. (Production resolves to ~/logs,
# outside the repo, so this is a local-machine guard.)
logs/
