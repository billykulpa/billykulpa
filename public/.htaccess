Options -Indexes

RewriteEngine On

# On hosts where app/ must live inside the web root, block all direct access.
RewriteRule ^app/ - [F,L]

# Serve real files (assets) directly; route everything else through index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Caching for static assets. Everything under /assets is cache-busted by
# name or by ?v=<filemtime>, so these can be long. Fonts were missing here
# entirely, which is what PageSpeed's "efficient cache lifetimes" flagged.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType audio/mp4 "access plus 1 year"
</IfModule>

# Mark the same assets immutable so browsers skip revalidation entirely.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|webp|png|jpe?g|ico|mp4|m4a)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
